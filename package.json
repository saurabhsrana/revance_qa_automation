{
  "name": "playwrightautomation",
  "version": "1.0.0",
  "description": "Revance Loyalty Cucumber + Playwright automation (welcome + complete profile)",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test": "cucumber-js --profile default",
    "test:smoke": "cucumber-js --profile smoke",
    "test:regression": "cucumber-js --profile regression",
    "test:debug": "cross-env HEADED=true SLOW_MO=50 cucumber-js --profile debug",
    "test:welcome": "cross-env PARALLEL_WORKERS=1 HEADLESS=true cucumber-js --tags \"@welcome\" --format summary",
    "test:welcome:headed": "cross-env PARALLEL_WORKERS=1 HEADED=true cucumber-js --tags \"@welcome\" --format summary",
    "test:completeprofile": "cross-env TEST_ENV=qa PARALLEL_WORKERS=1 HEADLESS=true cucumber-js --tags \"@completeprofile\" --format summary",
    "test:completeprofile:headed": "cross-env TEST_ENV=qa PARALLEL_WORKERS=1 HEADED=true cucumber-js --tags \"@completeprofile\" --format summary",
    "test:loyalty": "cross-env PARALLEL_WORKERS=1 HEADLESS=true cucumber-js --tags \"@welcome or @completeprofile\" --format summary",
    "test:parallel": "cross-env PARALLEL_WORKERS=4 cucumber-js --profile default",
    "test:chromium": "cross-env BROWSER=chromium cucumber-js --profile smoke",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js --profile smoke",
    "test:webkit": "cross-env BROWSER=webkit cucumber-js --profile smoke",
    "test:all-browsers": "node scripts/run-sequential.js test:chromium test:firefox test:webkit",
    "allure:clean": "node scripts/allure-clean.js",
    "allure:generate": "node ./node_modules/allure/cli.js generate --config allurerc.cjs reports/allure-results",
    "allure:open": "node ./node_modules/allure/cli.js open reports/allure-report",
    "allure:serve": "node ./node_modules/allure/cli.js open reports/allure-results",
    "allure:report": "node scripts/run-sequential.js allure:generate allure:open",
    "traceability:generate": "node scripts/generate-traceability.js",
    "ci:summary": "node scripts/ci-job-summary.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"cucumber.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"cucumber.js\""
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.7.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.9.5",
    "allure": "^3.16.0",
    "allure-cucumberjs": "^3.11.1",
    "allure-js-commons": "^3.11.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.6.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "winston": "^3.19.0"
  }
}
