# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Environment selector: dev | qa | prod
TEST_ENV=qa

# Loyalty (optional override of src/config/env.{TEST_ENV}.ts baseUrl)
# BASE_URL=https://revance-loyalty-env-qa-revances-projects.vercel.app

# OCE (kept for src/config / oceAuth — not used by welcome/completeprofile)
OCE_BASE_URL=
OCE_USERNAME=
OCE_PASSWORD=
OCE_PRACTICE=Pleasanton Dermatology
OCE_LOCATION=Pleasanton - CA

# Loyalty signup OTP (overrides feature Examples when set)
# SIGNUP_OTP=112233

# Cucumber / browser
BROWSER=chromium
PARALLEL_WORKERS=4
HEADLESS=true
# HEADED=true

# GitHub Issues base for Allure @TC-* / @ISSUE-* links (must end with /)
# ALLURE_TMS_URL=https://github.com/OWNER/REPO/issues/
