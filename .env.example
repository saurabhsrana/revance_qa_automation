# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Environment selector: dev | qa | prod
TEST_ENV=qa

# Loyalty (optional override of src/config/env.{TEST_ENV}.ts baseUrl)
# BASE_URL=https://your-qa-app.example.com

# OCE (kept for src/config / oceAuth — not used by welcome/completeprofile)
OCE_BASE_URL=
OCE_USERNAME=
OCE_PASSWORD=
OCE_PRACTICE=Pleasanton Dermatology
OCE_LOCATION=Pleasanton - CA

# QA test OTP override (default for qa is otp in src/config/env.qa.ts)
# QA_TEST_OTP=your-qa-harness-otp

# Playwright / browser
BROWSER=chromium
PARALLEL_WORKERS=4
HEADLESS=true
# HEADED=true
